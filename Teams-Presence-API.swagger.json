{
  "swagger": "2.0",
  "info": {
    "title": "Teams Presence API",
    "description": "Retrieves Microsoft Teams presence for one or more users by Microsoft Entra object ID.",
    "version": "1.2"
  },
  "host": "graph.microsoft.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "consumes": [
    "application/json"
  ],
  "paths": {
    "/v1.0/communications/presences/{user-id}": {
      "get": {
        "tags": [
          "Presence"
        ],
        "summary": "Get user presence",
        "description": "Returns the availability and activity presence for the specified Microsoft Entra user.",
        "operationId": "GetUserPresence",
        "x-ms-summary": "Get user presence",
        "x-ms-visibility": "important",
        "security": [
          {
            "oauth2-auth": [
              "Presence.Read.All"
            ]
          }
        ],
        "parameters": [
          {
            "name": "user-id",
            "in": "path",
            "description": "Microsoft Entra object ID of the user.",
            "required": true,
            "type": "string",
            "format": "uuid",
            "x-ms-summary": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "The user's current Teams presence.",
            "schema": {
              "$ref": "#/definitions/Presence"
            },
            "examples": {
              "application/json": {
                "id": "aaaaaaaa-0000-1111-2222-bbbbbbbbbbbb",
                "availability": "Available",
                "activity": "Available"
              }
            }
          },
          "400": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "401": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "403": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "404": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "429": {
            "description": "The request was throttled. Honor Retry-After before retrying.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "format": "int32",
                "description": "Recommended delay before retrying, in seconds."
              }
            },
            "schema": {
              "$ref": "#/definitions/GraphError"
            },
            "examples": {
              "application/json": {
                "error": {
                  "code": "TooManyRequests",
                  "message": "Please retry the request after the specified delay.",
                  "innerError": {
                    "date": "2026-01-01T00:00:00Z",
                    "request-id": "00000000-0000-0000-0000-000000000000"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/responses/GraphErrorResponse"
          }
        }
      }
    },
    "/v1.0/communications/getPresencesByUserId": {
      "post": {
        "tags": [
          "Presence"
        ],
        "summary": "Get presence for multiple users",
        "description": "Returns presence for up to 650 Microsoft Entra users in one request.",
        "operationId": "GetPresencesByUserId",
        "x-ms-summary": "Get presence for multiple users",
        "x-ms-visibility": "important",
        "security": [
          {
            "oauth2-auth": [
              "Presence.Read.All"
            ]
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Microsoft Entra object IDs of up to 650 users.",
            "schema": {
              "type": "object",
              "required": [
                "ids"
              ],
              "properties": {
                "ids": {
                  "type": "array",
                  "minItems": 1,
                  "description": "Microsoft Entra object IDs (GUIDs). Maximum 650 IDs.",
                  "maxItems": 650,
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "example": {
                "ids": [
                  "aaaaaaaa-0000-1111-2222-bbbbbbbbbbbb",
                  "cccccccc-3333-4444-5555-dddddddddddd"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presence results for the requested users.",
            "schema": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Presence"
                  }
                }
              }
            },
            "examples": {
              "application/json": {
                "value": [
                  {
                    "id": "aaaaaaaa-0000-1111-2222-bbbbbbbbbbbb",
                    "availability": "Available",
                    "activity": "Available"
                  },
                  {
                    "id": "cccccccc-3333-4444-5555-dddddddddddd",
                    "availability": "Busy",
                    "activity": "InACall"
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "401": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "403": {
            "$ref": "#/responses/GraphErrorResponse"
          },
          "429": {
            "description": "The request was throttled. Honor Retry-After before retrying.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "format": "int32",
                "description": "Recommended delay before retrying, in seconds."
              }
            },
            "schema": {
              "$ref": "#/definitions/GraphError"
            }
          },
          "500": {
            "$ref": "#/responses/GraphErrorResponse"
          }
        }
      }
    }
  },
  "definitions": {
    "Presence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Microsoft Entra object ID of the user."
        },
        "availability": {
          "type": "string",
          "description": "Aggregated availability.",
          "x-ms-summary": "Availability"
        },
        "activity": {
          "type": "string",
          "description": "Current activity.",
          "x-ms-summary": "Activity"
        }
      }
    },
    "GraphError": {
      "type": "object",
      "description": "Microsoft Graph OData error response.",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "Microsoft Graph error code."
            },
            "message": {
              "type": "string",
              "description": "Human-readable error message."
            },
            "innerError": {
              "type": "object",
              "description": "Optional diagnostic details, which can include a request ID and timestamp.",
              "additionalProperties": true
            }
          }
        }
      },
      "example": {
        "error": {
          "code": "Forbidden",
          "message": "The request is not authorized.",
          "innerError": {
            "request-id": "00000000-0000-0000-0000-000000000000"
          }
        }
      }
    }
  },
  "parameters": {},
  "responses": {
    "GraphErrorResponse": {
      "description": "A Microsoft Graph error response.",
      "schema": {
        "$ref": "#/definitions/GraphError"
      },
      "x-ms-error-response": true
    }
  },
  "securityDefinitions": {
    "oauth2-auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scopes": {
        "Presence.Read.All": "Presence.Read.All"
      }
    }
  },
  "security": [
    {
      "oauth2-auth": [
        "Presence.Read.All"
      ]
    }
  ]
}
